# HTTP
PORT=4000
# Set HOST=127.0.0.1 in production so only the reverse proxy can reach the API.
HOST=
# Comma-separated list of origins allowed to call the API (the Next.js app).
CORS_ORIGINS=http://localhost:3000

# Where the JSON store and attestor keys are persisted.
DATA_DIR=./data

# 32+ char secret used to derive the vault sealing key. Change this in production.
VAULT_MASTER_SECRET=change-me-to-a-long-random-string

# Robinhood Chain (mainnet chain id 4663). Public RPC is rate limited;
# use Alchemy/QuickNode/Chainstack for production.
CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com

# $ECLS token. Leave empty until the Pons launch transaction is confirmed.
# While empty, every wallet that signs in to the console gets Early access (Holder perks).
# Once set, the console reads each wallet's balance on chain and picks its tier
# (thresholds live in src/catalog.ts, holderTiers).
TOKEN_ADDRESS=
PONS_LAUNCHPAD_URL=https://ponsfamily.com/launchpad

# Devnet only: preview tiers before launch with simulated balances, as address=amount pairs.
# Ignored once TOKEN_ADDRESS is set.
DEV_HOLDER_BALANCES=

# Optional: forward /v1/chat/completions to a real OpenAI-compatible confidential
# inference provider. Without these, the gateway runs in simulation mode.
UPSTREAM_LLM_BASE_URL=
UPSTREAM_LLM_API_KEY=
